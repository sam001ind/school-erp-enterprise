generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  password        String
  name            String
  roleId          String
  role            Role           @relation(fields: [roleId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  studentProfile  StudentProfile?
  guardianProfile Guardian?
  employeeProfile Employee?
  circulations    Circulation[]
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  users       User[]
  permissions Permission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id        String   @id @default(uuid())
  action    String   @unique
  roles     Role[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentProfile {
  id                  String               @id @default(uuid())
  userId              String               @unique
  user                User                 @relation(fields: [userId], references: [id])
  admissionNo         String               @unique
  dateOfBirth         DateTime
  gender              String
  bloodGroup          String?
  guardianId          String?
  guardian            Guardian?            @relation(fields: [guardianId], references: [id])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  
  documents           Document[]
  attendances         Attendance[]
  examResults         ExamResult[]
  feePayments         FeePayment[]
  transportAllocation TransportAllocation?
  hostelAllocation    HostelAllocation?
}

model Guardian {
  id             String           @id @default(uuid())
  userId         String           @unique
  user           User             @relation(fields: [userId], references: [id])
  phone          String
  relation       String
  students       StudentProfile[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Document {
  id             String         @id @default(uuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id])
  documentType   String
  fileUrl        String
  uploadedAt     DateTime       @default(now())
}

// Phase 2
model Attendance {
  id          String         @id @default(uuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id])
  date        DateTime
  status      String
  remarks     String?
  recordedAt  DateTime       @default(now())
}

model Examination {
  id          String       @id @default(uuid())
  name        String
  term        String
  startDate   DateTime
  endDate     DateTime
  results     ExamResult[]
  createdAt   DateTime     @default(now())
}

model ExamResult {
  id            String         @id @default(uuid())
  examinationId String
  examination   Examination    @relation(fields: [examinationId], references: [id])
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id])
  subject       String
  marksObtained Float
  totalMarks    Float
  grade         String?
  recordedAt    DateTime       @default(now())
}

model FeeStructure {
  id          String       @id @default(uuid())
  name        String
  amount      Float
  dueDate     DateTime
  term        String
  payments    FeePayment[]
  createdAt   DateTime     @default(now())
}

model FeePayment {
  id             String         @id @default(uuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id])
  feeStructureId String
  feeStructure   FeeStructure   @relation(fields: [feeStructureId], references: [id])
  amountPaid     Float
  paymentDate    DateTime       @default(now())
  status         String
  receiptNo      String         @unique
}

// ==========================================
// Phase 3: Secondary Operations
// ==========================================

model Employee {
  id             String         @id @default(uuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id])
  employeeId     String         @unique
  department     String
  designation    String
  joiningDate    DateTime
  baseSalary     Float
  payrolls       Payroll[]
  leaves         LeaveRequest[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Payroll {
  id             String    @id @default(uuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id])
  month          Int
  year           Int
  basicPay       Float
  allowances     Float
  deductions     Float
  netPay         Float
  status         String    // "PROCESSED", "PAID"
  processedAt    DateTime  @default(now())
}

model LeaveRequest {
  id             String    @id @default(uuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id])
  leaveType      String    // "SICK", "CASUAL", "ANNUAL"
  startDate      DateTime
  endDate        DateTime
  reason         String
  status         String    // "PENDING", "APPROVED", "REJECTED"
  appliedAt      DateTime  @default(now())
}

model Book {
  id             String        @id @default(uuid())
  isbn           String        @unique
  title          String
  author         String
  totalCopies    Int
  availableCopies Int
  circulations   Circulation[]
  createdAt      DateTime      @default(now())
}

model Circulation {
  id             String    @id @default(uuid())
  bookId         String
  book           Book      @relation(fields: [bookId], references: [id])
  userId         String    // Borrowed by user (student or employee)
  user           User      @relation(fields: [userId], references: [id])
  issueDate      DateTime  @default(now())
  dueDate        DateTime
  returnDate     DateTime?
  status         String    // "ISSUED", "RETURNED", "OVERDUE"
}

model TransportRoute {
  id             String                @id @default(uuid())
  routeName      String                @unique
  driverName     String
  vehicleNumber  String
  capacity       Int
  allocations    TransportAllocation[]
}

model TransportAllocation {
  id             String         @id @default(uuid())
  routeId        String
  route          TransportRoute @relation(fields: [routeId], references: [id])
  studentId      String         @unique
  student        StudentProfile @relation(fields: [studentId], references: [id])
  pickupPoint    String
  allocatedAt    DateTime       @default(now())
}

model HostelRoom {
  id             String             @id @default(uuid())
  roomNumber     String             @unique
  capacity       Int
  occupancy      Int                @default(0)
  allocations    HostelAllocation[]
}

model HostelAllocation {
  id             String         @id @default(uuid())
  roomId         String
  room           HostelRoom     @relation(fields: [roomId], references: [id])
  studentId      String         @unique
  student        StudentProfile @relation(fields: [studentId], references: [id])
  allocatedAt    DateTime       @default(now())
}
